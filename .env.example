# Plantilla: todos los valores son marcadores, nunca agregues credenciales reales aquí.
DB_URL=jdbc:oracle:thin:@panpuntospremios_low?TNS_ADMIN=C:/ruta/al/Wallet_panpuntospremios
DB_USER=APP_PUNTOS_API
DB_PASSWORD=REEMPLAZAR
DB_SCHEMA=ADMIN

# Proveedor de correo: smtp (predeterminado) o emailjs
EMAIL_PROVIDER=emailjs

# EmailJS: configura estos valores en el entorno del backend (nunca en Next.js)
EMAILJS_SERVICE_ID=REEMPLAZAR
EMAILJS_TEMPLATE_ID=REEMPLAZAR
EMAILJS_PUBLIC_KEY=REEMPLAZAR
EMAILJS_PRIVATE_KEY=REEMPLAZAR

# URL base usada en los enlaces enviados por correo.
# Local: http://localhost:3000. En OCI cambiar a la URL HTTPS pública de Vercel.
APP_PORTAL_BASE_URL=http://localhost:3000

# false en localhost; true detrás de HTTPS en producción.
SESSION_COOKIE_SECURE=false

# SMTP alternativo (EMAIL_PROVIDER=smtp)
MAIL_HOST=smtp.email.mx-queretaro-1.oci.oraclecloud.com
MAIL_PORT=587
MAIL_USERNAME=USUARIO_SMTP_GENERADO_POR_OCI
MAIL_PASSWORD=CONTRASENA_SMTP_GENERADA_POR_OCI
MAIL_FROM=no-reply@tu-dominio.com
MAIL_SMTP_SSL=false
MAIL_SMTP_STARTTLS=true
